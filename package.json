{
  "name": "git-diff-graph",
  "version": "0.1.0",
  "description": "Visualize git diffs as an interactive graph: modules → files → functions → code, with import changes, stage and commit",
  "keywords": [
    "git",
    "diff",
    "git-diff",
    "visualize",
    "visualization",
    "graph",
    "dependency-graph",
    "code-review",
    "changes",
    "ai-agent",
    "cursor",
    "claude-code",
    "typescript",
    "cli"
  ],
  "type": "module",
  "license": "MIT",
  "bin": {
    "git-diff-graph": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:web && npm run build:node",
    "build:node": "tsup",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cac": "^7.1.0",
    "chokidar": "^5.0.0",
    "elkjs": "^0.12.0",
    "open": "^11.0.4",
    "web-tree-sitter": "^0.27.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
